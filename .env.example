# Oracle integration tests. Read-only credentials work with oracle_integration.
# oracle_write_integration requires a dedicated disposable schema; it creates/drops go_test.
# Copy to .env and fill in all three values; no database defaults are used.
# Existing environment variables take precedence, including empty values.
ORA_TEST_USER=
# Single quotes preserve literal characters such as $, #, and @.
ORA_TEST_PASSWORD=''
# Format: //hostname:1521/service_name (or a configured TNS alias).
ORA_TEST_HOST=
